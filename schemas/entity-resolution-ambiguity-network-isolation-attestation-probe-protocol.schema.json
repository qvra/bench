    "probes": {
      "const": [
        {
          "control_required": false,
          "expected_exit_code": 0,
          "id": "profile_acceptance",
          "network_operation": false,
          "objective": "prove exact profile text is accepted by exact sandbox-exec binary",
          "pass_requirements": [
            "sandbox-exec exits zero",
            "stderr contains no profile parse failure",
            "exact profile text is supplied with -p"
          ],
          "sandbox_invocation_required": true,
          "sandbox_target": "/usr/bin/true",
          "satisfies": [
            "profile_syntax_validated"
          ]
        },
        {
          "control_operation": "connect to host-owned TCP listener on 127.0.0.1 ephemeral port",
          "control_pass": "control connection accepted",
          "control_required": true,
          "host_observer": "host-owned TCP listener",
          "id": "tcp_loopback_connect",
          "objective": "prove sandboxed outbound TCP and loopback TCP are denied",
          "sandbox_operation": "same TCP connect operation under exact sandbox profile",
          "sandbox_pass": "permission denial EPERM/EACCES and no sandbox connection accepted",
          "satisfies": [
            "outbound_tcp_denied",
            "loopback_tcp_denied"
          ]
        },
        {
          "control_operation": "send fixed datagram to host-owned UDP receiver on 127.0.0.1 ephemeral port",
          "control_pass": "exact control datagram received",
          "control_required": true,
          "host_observer": "host-owned UDP receiver",
          "id": "udp_loopback_send",
          "objective": "prove sandboxed outbound UDP is denied",
          "sandbox_operation": "same UDP send operation under exact sandbox profile",
          "sandbox_pass": "permission denial EPERM/EACCES and no sandbox datagram received",
          "satisfies": [
            "outbound_udp_denied"
          ]
        },
        {
          "control_operation": "bind and listen on 127.0.0.1 ephemeral port then close",
          "control_pass": "bind and listen succeeds",
          "control_required": true,
          "host_observer": "child probe result only",
          "id": "tcp_inbound_bind_listen",
          "objective": "prove sandboxed TCP bind/listen is denied",
          "sandbox_operation": "same bind/listen sequence under exact sandbox profile",
          "sandbox_pass": "permission denial EPERM/EACCES at socket/bind/listen",
          "satisfies": [
            "inbound_listen_denied"
          ]
        },
        {
          "control_operation": "unsandboxed parent spawns child that connects to host TCP listener",
          "control_pass": "control child connection accepted",
          "control_required": true,
          "host_observer": "host-owned TCP listener",
          "id": "child_process_tcp_connect",
          "objective": "prove sandbox restrictions are inherited by a spawned child process",
          "sandbox_operation": "sandboxed parent spawns same child and child attempts same TCP connect",
          "sandbox_pass": "sandbox child receives EPERM/EACCES and no sandbox child connection accepted",
          "satisfies": [
            "child_process_network_denied"
          ]
        },
        {
          "control_operation": "connect to host-owned AF_UNIX stream listener in temporary directory",
          "control_pass": "control Unix-domain connection accepted",
          "control_required": true,
          "host_observer": "host-owned AF_UNIX listener",
          "id": "unix_stream_connect",
          "objective": "explicitly determine and require denial of Unix-domain stream connect",
          "sandbox_operation": "same AF_UNIX connect under exact sandbox profile",
          "sandbox_pass": "permission denial EPERM/EACCES and no sandbox Unix-domain connection accepted",
          "satisfies": [
            "unix_domain_socket_policy_tested",
            "unix_domain_connect_denied"
          ]
        },
        {
          "control_operation": "bind AF_UNIX stream socket at temporary control path then close and unlink",
          "control_pass": "control bind succeeds",
          "control_required": true,
          "host_observer": "filesystem path existence plus child probe result",
          "id": "unix_stream_bind",
          "objective": "explicitly determine and require denial of Unix-domain stream bind",
          "sandbox_operation": "bind AF_UNIX stream socket at separate temporary sandbox path",
          "sandbox_pass": "permission denial EPERM/EACCES and sandbox socket path is not created",
          "satisfies": [
            "unix_domain_socket_policy_tested",
            "unix_domain_bind_denied"
          ]
        }
      ]
    },
